# ─── Database ────────────────────────────────────────────────────────────────
# By default `npm run dev` starts a local Postgres from the embedded-postgres package
# (data in .data/postgres), so no install is needed. The URL below matches it.
DATABASE_URL="postgresql://streamly:streamly@localhost:5433/streamly"
# Set to "false" to use your own Postgres at DATABASE_URL instead.
USE_EMBEDDED_POSTGRES="true"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or any 32+ char random string)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Required behind proxies / in production so Auth.js trusts the host header.
AUTH_TRUST_HOST="true"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Media storage ───────────────────────────────────────────────────────────
# local | s3 | cloudinary. Only "local" is implemented; the others are isolated
# stubs in src/server/storage/ that show where credentials plug in.
STORAGE_DRIVER="local"
# Where local uploads are written (served through /api/media/*).
LOCAL_STORAGE_DIR="./storage/uploads"
MAX_VIDEO_SIZE_MB="500"
MAX_THUMBNAIL_SIZE_MB="5"

# S3 (STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Cloudinary (STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
