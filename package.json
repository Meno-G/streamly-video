{
  "name": "streamly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db.mjs next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/with-db.mjs next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:up": "node scripts/with-db.mjs",
    "db:migrate": "node scripts/with-db.mjs prisma migrate dev",
    "db:seed": "node scripts/with-db.mjs prisma db seed",
    "db:reset": "node scripts/with-db.mjs prisma migrate reset --force",
    "db:studio": "node scripts/with-db.mjs prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
